NODE_ENV=development
BIND_HOST=127.0.0.1

WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002
COMFYUI_ADAPTER_PORT=3003
MEDIA_WORKER_PORT=8001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=ai_drama
POSTGRES_USER=ai_drama
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql://ai_drama:dev-only-change-me@127.0.0.1:55432/ai_drama

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=ai-drama-dev
S3_ACCESS_KEY_ID=ai-drama-dev
S3_SECRET_ACCESS_KEY=dev-only-change-me
S3_FORCE_PATH_STYLE=true
S3_API_PORT=59000
S3_CONSOLE_PORT=59001
MINIO_ROOT_USER=ai-drama-dev
MINIO_ROOT_PASSWORD=dev-only-change-me

COMFYUI_BASE_URL=
COMFYUI_MODE=stub
HEALTH_CHECK_TIMEOUT_MS=2000
APP_WORKSPACE_ID=11111111-1111-4111-8111-111111111111

# Mock image reads stay disabled until this is true and MOCK_OBJECT_DIR is absolute.
# Mock video and speech stay disabled until M3_MOCK_AV_ENABLED is true as well.
# Mock subtitle and music stay disabled until M3_MOCK_SUBTITLE_MUSIC_ENABLED is true.
# None of these flags enables the others. The page does not receive these values.
# Example: MOCK_OBJECT_DIR=D:\ai-drama-mock-objects
M3_MOCK_IMAGE_ENABLED=false
M3_MOCK_AV_ENABLED=false
M3_MOCK_SUBTITLE_MUSIC_ENABLED=false

# Local single-shot compose stays disabled unless this is true outside production.
# It does not enable image, video, speech, subtitle, or music generation.
# Worker single-shot compose also requires an absolute MOCK_OBJECT_DIR.
# M4_COMPOSE_WORK_DIR and M4_COMPOSE_OBJECT_DIR must be absolute when the flag is true.
# Do not set those paths to an empty string. z.string().min(1).optional() rejects it.
# Example: M4_COMPOSE_WORK_DIR=D:\ai-drama-compose-work
# Example: M4_COMPOSE_OBJECT_DIR=D:\ai-drama-compose-objects
# Example: M4_COMPOSE_PYTHON=D:\ai-drama-studio\services\media-worker\.venv\Scripts\python.exe
M4_LOCAL_COMPOSE_ENABLED=false
# Episode compose stays disabled unless this and M4_LOCAL_COMPOSE_ENABLED are both true
# outside production. It uses the absolute compose directories above. It does not use MOCK_OBJECT_DIR.
M4_LOCAL_EPISODE_COMPOSE_ENABLED=false
# Sample clips stay disabled unless this flag, M3_MOCK_AV_ENABLED, and an absolute MOCK_OBJECT_DIR are set.
# Example: M4_MOCK_SAMPLE_VIDEO_ENABLED=false
M4_MOCK_SAMPLE_VIDEO_ENABLED=false
# MEDIA_WORKER_PYTHON is only the interpreter for pnpm verify. It does not select the worker compose CLI
# and it does not start the Python HTTP health process.
# Example: MEDIA_WORKER_PYTHON=D:\ai-drama-studio\services\media-worker\.venv\Scripts\python.exe
# Test controls. A disabled flag or production forces the commit injection off and the lease back to 30s.
# M4_COMPOSE_LEASE_MS=30000
# M4_COMPOSE_FAIL_INSIDE_COMMIT=false
