NODE_ENV=development
BIND_HOST=127.0.0.1

WEB_PORT=3000
API_PORT=3001
WORKER_HEALTH_PORT=3002
COMFYUI_ADAPTER_PORT=3003
MEDIA_WORKER_PORT=8001
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:3001

POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=55432
POSTGRES_DB=ai_drama
POSTGRES_USER=ai_drama
POSTGRES_PASSWORD=dev-only-change-me
DATABASE_URL=postgresql://ai_drama:dev-only-change-me@127.0.0.1:55432/ai_drama

REDIS_HOST=127.0.0.1
REDIS_PORT=56379
REDIS_URL=redis://127.0.0.1:56379

S3_ENDPOINT=http://127.0.0.1:59000
S3_REGION=us-east-1
S3_BUCKET=ai-drama-dev
S3_ACCESS_KEY_ID=ai-drama-dev
S3_SECRET_ACCESS_KEY=dev-only-change-me
S3_FORCE_PATH_STYLE=true
S3_API_PORT=59000
S3_CONSOLE_PORT=59001
MINIO_ROOT_USER=ai-drama-dev
MINIO_ROOT_PASSWORD=dev-only-change-me

COMFYUI_BASE_URL=
COMFYUI_MODE=stub
HEALTH_CHECK_TIMEOUT_MS=2000
APP_WORKSPACE_ID=11111111-1111-4111-8111-111111111111

# Mock image reads stay disabled until this is true and MOCK_OBJECT_DIR is absolute.
# Mock video and speech stay disabled until M3_MOCK_AV_ENABLED is true as well.
# Mock subtitle and music stay disabled until M3_MOCK_SUBTITLE_MUSIC_ENABLED is true.
# None of these flags enables the others. The page does not receive these values.
# Example: MOCK_OBJECT_DIR=D:\ai-drama-mock-objects
M3_MOCK_IMAGE_ENABLED=false
M3_MOCK_AV_ENABLED=false
M3_MOCK_SUBTITLE_MUSIC_ENABLED=false

# Local single-shot compose stays disabled unless explicitly enabled.
# It does not enable image, video, speech, subtitle, or music generation.
# Mock inputs require absolute MOCK_OBJECT_DIR and stay forbidden in production.
# Real S3 inputs use the independent real-media gates below; they do not need a Mock directory.
# M4_COMPOSE_WORK_DIR and M4_COMPOSE_OBJECT_DIR must be absolute when the flag is true.
# Do not set those paths to an empty string. z.string().min(1).optional() rejects it.
# Example: M4_COMPOSE_WORK_DIR=D:\ai-drama-compose-work
# Example: M4_COMPOSE_OBJECT_DIR=D:\ai-drama-compose-objects
# Example: M4_COMPOSE_PYTHON=D:\ai-drama-studio\services\media-worker\.venv\Scripts\python.exe
M4_LOCAL_COMPOSE_ENABLED=false
# Episode compose has its own switch; it does not require M4_LOCAL_COMPOSE_ENABLED.
# Existing local-compose clips need no original Mock directory. Production additionally requires
# process-only real-media production permission, site authentication and verified real sources.
# It uses the absolute compose directories above. It does not use MOCK_OBJECT_DIR.
M4_LOCAL_EPISODE_COMPOSE_ENABLED=false
# Sample clips stay disabled unless this flag, M3_MOCK_AV_ENABLED, and an absolute MOCK_OBJECT_DIR are set.
# Example: M4_MOCK_SAMPLE_VIDEO_ENABLED=false
# Video gate for character reference images. legacy keeps the existing Mock video contract; strict requires
# selected, approved reference images and the unapplied reference draft (it refuses video without them).
M3_CHARACTER_REFERENCE_GATE=legacy
M4_MOCK_SAMPLE_VIDEO_ENABLED=false
# MEDIA_WORKER_PYTHON is only the interpreter for pnpm verify. It does not select the worker compose CLI
# and it does not start the Python HTTP health process.
# Example: MEDIA_WORKER_PYTHON=D:\ai-drama-studio\services\media-worker\.venv\Scripts\python.exe
# Text writing providers: DeepSeek, Claude (Anthropic API) and OpenAI. Qwen text is retired: its old DASHSCOPE_*,
# BAILIAN_* and QWEN_* text variables are no longer read. New DASHSCOPE_MEDIA_* below is an independent media path.
# DeepSeek is configured only in
# the model console (/admin/models): DEEPSEEK_* variables are not read, so a key left from before its retirement is unused.
# The API reads provider keys and model allowlists only from its process environment, never from this file.
# Example: OPENAI_API_KEY is set in the process environment, never in this file.
# Example: TITLE_WRITING_OPENAI_MODELS=gpt-6-luna
# Example: ANTHROPIC_API_KEY is an Anthropic Console API key in the process environment, never in this file.
#   It is never a Claude Code login, a subscription session or any token taken from a browser.
# Example: TITLE_WRITING_ANTHROPIC_MODELS=claude-opus-5-5,claude-sonnet-5-5
# Example: TITLE_WRITING_DEFAULT_PROVIDER=anthropic   (openai or anthropic; a retired value means no default)
# Claude runs also need migration 20261016000100_writing_provider_anthropic; until it is applied the API refuses
# them before any write or call. Apply it alone with: pnpm --filter @ai-drama/database migrate -- --only 20261016000100_writing_provider_anthropic
# Title writing and script breakdown stay off by default. Breakdown needs both switches and is always off in
# production. The operator token is a server-side secret and is never stored here.
# TITLE_WRITING_ENABLED=false
# SCRIPT_BREAKDOWN_ENABLED=false
# AI automatic creation (docs/AI_AUTO_CREATION.md): also needs TITLE_WRITING_ENABLED=true and migration
# 20261019000100_auto_creation. Public page reading for its research snapshot is a separate switch, off by default.
# AUTO_CREATION_ENABLED=false
# AUTO_CREATION_RESEARCH_FETCH=false
# Series writing (1–60 episodes, docs/SERIES_WRITING.md). Needs title writing on and migration 20261023000100_series_writing.
SERIES_WRITING_ENABLED=false
# AUTO_CREATION_RESEARCH_HOSTS=support.oceanengine.com,school.oceanengine.com
# Test controls. A disabled flag or production forces the commit injection off and the lease back to 30s.
# M4_COMPOSE_LEASE_MS=30000
# M4_COMPOSE_FAIL_INSIDE_COMMIT=false

# Real media: code is implemented but disabled by default. See docs/REAL_MEDIA_RUNBOOK.md.
# Enabling these switches is not paid authorization, SQL installation, provisioning or deployment.
# API AND Worker require valid process-only SITE_AUTH_* settings, including in development.
REAL_MEDIA_ENABLED=false
VIMAX_PLANNING_ENABLED=false
# Process-only production permissions (never authorize production from this file):
# REAL_MEDIA_ALLOW_PRODUCTION=false
# VIMAX_ALLOW_PRODUCTION=false

# Receipt encryption and provider API keys are PROCESS-ONLY secrets. Do not fill keys in this file.
# REAL_MEDIA_RECEIPT_KEY (canonical base64 encoding of 32 bytes; API and Worker must agree)
# REAL_MEDIA_RECEIPT_KEY_VERSION (default v1; process-only)
# REAL_MEDIA_PREVIOUS_RECEIPT_KEY
# REAL_MEDIA_PREVIOUS_RECEIPT_KEY_VERSION
# DASHSCOPE_MEDIA_API_KEY
# DASHSCOPE_MEDIA_PREVIOUS_API_KEY
# ELEVENLABS_MEDIA_API_KEY
# ELEVENLABS_MEDIA_PREVIOUS_API_KEY
# OpenAI image is opt-in and process-only. Do not put keys or a base URL in this file.
# REAL_MEDIA_IMAGE_PROVIDER=dashscope-media
# OPENAI_MEDIA_API_KEY
# OPENAI_MEDIA_PREVIOUS_API_KEY
# OPENAI_BASE_URL
# OPENAI_API_BASE
# Non-secret credential versions: retain an old distinct version for query-only recovery during rotation.
# DASHSCOPE_MEDIA_CREDENTIAL_VERSION=v1
# DASHSCOPE_MEDIA_PREVIOUS_CREDENTIAL_VERSION
# ELEVENLABS_MEDIA_CREDENTIAL_VERSION=v1
# ELEVENLABS_MEDIA_PREVIOUS_CREDENTIAL_VERSION
# OPENAI_MEDIA_CREDENTIAL_VERSION=v1
# OPENAI_MEDIA_PREVIOUS_CREDENTIAL_VERSION

# Supply independently verified positive unit prices before the corresponding capability can open.
# No historical price is silently adopted. API/Worker must use the same snapshot version.
# REAL_MEDIA_PRICE_VERSION
# DASHSCOPE_MEDIA_PRICE_IMAGE
# DASHSCOPE_MEDIA_PRICE_VIDEO_SECOND
# DASHSCOPE_MEDIA_PRICE_TTS_CHARACTER
# ELEVENLABS_MEDIA_PRICE_MUSIC_SECOND
# OPENAI_MEDIA_PRICE_IMAGE
# DASHSCOPE_MEDIA_VIDEO_SECONDS=5
# ELEVENLABS_MEDIA_MUSIC_SECONDS=5
# REAL_MEDIA_MAX_SINGLE_CNY=10
# REAL_MEDIA_MAX_SINGLE_USD=2

# New local-ffmpeg-voice-v1 profile requires Noto Sans CJK SC, including actual subtitle glyphs.
# Optional operator-owned ABSOLUTE font path; no client-selected font paths. Do not set an empty value.
# M4_VOICE_COMPOSE_FONT_PATH=/usr/share/fonts/opentype/noto/NotoSansCJK-Regular.ttc
# A new named empty acceptance DB and explicit draft flags are required for each independent SQL suite.
# Never put acceptance authorizations or a business DB URL here; see docs/REAL_MEDIA_RUNBOOK.md.

# Storage settings (/settings/storage): PROCESS-ONLY values; these comments are not an enablement command.
# API and Worker must share the same workspace, master key, and endpoint allowlist.
# Requires separately reviewed storage SQL draft; startup never installs it. See docs/STORAGE_SETTINGS.md.
# STORAGE_SETTINGS_ENABLED=false
# STORAGE_SETTINGS_KEY (canonical base64 of 32 random bytes; inject with server secrets, never put a value here)
# STORAGE_SETTINGS_ALLOWED_ENDPOINTS=https://your-operator-owned-minio.example:9000
# Keep the key after disabling the console: immutable historical routes still need it.
# Existing S3_* values freeze as the legacy route on the first saved draft or media reservation.
