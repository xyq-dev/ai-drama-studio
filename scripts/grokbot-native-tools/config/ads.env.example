# Copy to a path OUTSIDE git (e.g. ~/.config/ai-drama-studio/ads.env) and chmod 600.
# Never paste these values into chat. Never commit a filled copy.
#
# ADS_API_BASE=https://drama.playhubs.cn/api/v1
# ADS_ORIGIN=https://drama.playhubs.cn
# ADS_SESSION_COOKIE=...
# ADS_CSRF_TOKEN=...
# ADS_LIVE_WRITES=0
# ADS_LOCAL_STORE=/home/box/.local/share/ai-drama-studio/store.json
#
# Speech is separate from music. Do not copy ELEVENLABS_MEDIA_* into these names.
# pcm_44100 and wav_44100 require an ElevenLabs Pro plan or higher.
# Leave the key unset for --mock unpaid tests.
# ELEVENLABS_TTS_API_KEY=
# ELEVENLABS_TTS_CREDENTIAL_VERSION=v1
# ELEVENLABS_TTS_PRICE_CHARACTER=
# ELEVENLABS_TTS_OUTPUT_FORMAT=pcm_44100
