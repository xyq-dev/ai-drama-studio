  "dependencies": {
    "@ai-drama/contracts": "workspace:*",
    "zod": "catalog:"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "clean": "node --eval \"require('node:fs').rmSync('dist',{recursive:true,force:true})\""
