      "default": "./dist/writing-assistant.js"
    },
    "./media-retry": {
      "types": "./dist/media-retry.d.ts",
      "default": "./dist/media-retry.js"
    },
    "./short-sequel-plan": {
      "types": "./dist/short-sequel-plan.d.ts",
      "default": "./dist/short-sequel-plan.js"
    },
    "./auto-creation-cost-display": {
      "types": "./dist/auto-creation-cost-display.d.ts",
      "default": "./dist/auto-creation-cost-display.js"
    },
    "./auto-creation-media-capability": {
      "types": "./dist/auto-creation-media-capability.d.ts",
      "default": "./dist/auto-creation-media-capability.js"
    },
    "./commercial-web-robustness": {
      "types": "./dist/commercial-web-robustness.d.ts",
      "default": "./dist/commercial-web-robustness.js"
    },
