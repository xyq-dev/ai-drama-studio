model ShotCharacterReference {
  workspaceId         String @map("workspace_id") @db.Uuid
  projectId           String @map("project_id") @db.Uuid
  shotRevisionId      String @map("shot_revision_id") @db.Uuid
  characterRevisionId String @map("character_revision_id") @db.Uuid
  role                String

  @@id([shotRevisionId, characterRevisionId])
  @@index([workspaceId, characterRevisionId])
  @@map("shot_character_reference")
}

model StaleRecalculation {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId  String   @map("workspace_id") @db.Uuid
  projectId    String   @map("project_id") @db.Uuid
  staleFromRef String   @map("stale_from_ref")
  reason       String
  status       String   @default("PENDING")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @default(now()) @map("updated_at") @db.Timestamptz(6)

  @@unique([workspaceId, projectId, staleFromRef])
  @@index([workspaceId, status, createdAt])
  @@map("stale_recalculation")
}

model ScriptSourceDependency {
  id                    String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId           String   @map("workspace_id") @db.Uuid
  projectId             String   @map("project_id") @db.Uuid
  scriptRevisionId      String   @map("script_revision_id") @db.Uuid
  consumerType          String   @map("consumer_type")
  consumerRevisionId    String   @map("consumer_revision_id") @db.Uuid
  sceneRevisionId       String?  @map("scene_revision_id") @db.Uuid
  shotRevisionId        String?  @map("shot_revision_id") @db.Uuid
  characterRevisionId   String?  @map("character_revision_id") @db.Uuid
  locationRevisionId    String?  @map("location_revision_id") @db.Uuid
  sourcePath            String[] @map("source_path")
  sourceValue           Json     @map("source_value") @db.JsonB
  sourceValueHash       String   @map("source_value_hash")
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([consumerType, consumerRevisionId, scriptRevisionId, sourcePath], map: "script_source_dependency_consumer_path_key")
  @@index([workspaceId, projectId, scriptRevisionId], map: "script_source_dependency_source_idx")
  @@map("script_source_dependency")
}

model ScriptRevisionReplacement {
  previousScriptRevisionId String   @id @map("previous_script_revision_id") @db.Uuid
  newScriptRevisionId      String   @unique @map("new_script_revision_id") @db.Uuid
  workspaceId              String   @map("workspace_id") @db.Uuid
  projectId                String   @map("project_id") @db.Uuid
  episodeId                String   @map("episode_id") @db.Uuid
  createdAt                DateTime @default(dbgenerated("clock_timestamp()")) @map("created_at") @db.Timestamptz(6)

  @@map("script_revision_replacement")
}

model Asset {
  id                      String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId             String   @map("workspace_id") @db.Uuid
  projectId               String   @map("project_id") @db.Uuid
  kind                    String
  storageProvider         String   @map("storage_provider")
  objectKey               String   @map("object_key")
  mimeType                String   @map("mime_type")
  byteSize                BigInt   @map("byte_size")
  checksumSha256          String   @map("checksum_sha256")
  width                   Int?
  height                  Int?
  durationMs              BigInt?  @map("duration_ms")
  sourceKind              String   @default("PROVIDER") @map("source_kind")
  sourceJobAttemptId      String?  @map("source_job_attempt_id") @db.Uuid
  sourceGenerationJobId   String?  @map("source_generation_job_id") @db.Uuid
  sourceShotRevisionId    String?  @map("source_shot_revision_id") @db.Uuid
  providerConfigurationId String?  @map("provider_configuration_id") @db.Uuid
  providerRequestId       String?  @map("provider_request_id")
  metadataJson            Json     @default("{}") @map("metadata_json") @db.JsonB
  status                  String   @default("ACTIVE")
  reviewStatus            String   @default("DRAFT") @map("review_status")
  reviewedBy              String?  @map("reviewed_by")
  reviewedAt              DateTime? @map("reviewed_at") @db.Timestamptz(6)
  reviewNote              String?  @map("review_note")
  reviewedContentHash     String?  @map("reviewed_content_hash")
  rowVersion              Int      @default(1) @map("row_version")
  createdAt               DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@unique([storageProvider, objectKey])
  @@unique([id, workspaceId])
  @@unique([id, projectId, workspaceId])
  @@index([workspaceId, projectId, kind, createdAt])
  @@index([workspaceId, sourceShotRevisionId, createdAt])
  @@index([workspaceId, projectId, checksumSha256, kind])
  @@index([workspaceId, projectId, status])
  @@map("asset")
}

/// Immutable, project-scoped edge from a derived asset to an exact input asset.
model AssetDependency {
  workspaceId      String   @map("workspace_id") @db.Uuid
  projectId        String   @map("project_id") @db.Uuid
  dependentAssetId String   @map("dependent_asset_id") @db.Uuid
  sourceAssetId    String   @map("source_asset_id") @db.Uuid
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@id([dependentAssetId, sourceAssetId])
  @@index([workspaceId, projectId, sourceAssetId])
  @@map("asset_dependency")
}

/// Immutable edge to one typed source revision in the dependent asset's project.
model AssetRevisionDependency {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workspaceId         String   @map("workspace_id") @db.Uuid
  projectId           String   @map("project_id") @db.Uuid
  dependentAssetId    String   @map("dependent_asset_id") @db.Uuid
  shotRevisionId      String?  @map("shot_revision_id") @db.Uuid
  sceneRevisionId     String?  @map("scene_revision_id") @db.Uuid
  scriptRevisionId    String?  @map("script_revision_id") @db.Uuid
  characterRevisionId String?  @map("character_revision_id") @db.Uuid
  locationRevisionId  String?  @map("location_revision_id") @db.Uuid
  createdAt           DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@index([workspaceId, projectId, shotRevisionId])
  @@index([workspaceId, projectId, sceneRevisionId])
  @@index([workspaceId, projectId, scriptRevisionId])
  @@index([workspaceId, projectId, characterRevisionId])
  @@index([workspaceId, projectId, locationRevisionId])
  @@map("asset_revision_dependency")
}
