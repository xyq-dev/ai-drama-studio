}

model CharacterRevisionScriptSource {
  workspaceId         String @map("workspace_id") @db.Uuid
  projectId           String @map("project_id") @db.Uuid
  characterRevisionId String @map("character_revision_id") @db.Uuid
  scriptRevisionId    String @map("script_revision_id") @db.Uuid

