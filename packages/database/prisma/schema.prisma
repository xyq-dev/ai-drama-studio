  projectId          String @map("project_id") @db.Uuid
  locationRevisionId String @map("location_revision_id") @db.Uuid
  scriptRevisionId   String @map("script_revision_id") @db.Uuid

  @@id([locationRevisionId, scriptRevisionId])
  @@index([workspaceId, scriptRevisionId])
  @@map("location_revision_script_source")
}

