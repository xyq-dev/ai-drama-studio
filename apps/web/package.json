{
  "name": "@ai-drama/web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node ./scripts/dev.mjs",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1 --port 3000",
